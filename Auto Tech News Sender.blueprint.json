            "mapper": {
                "model": "gpt-5.2",
                "textPrompt": "You are a professional tech analyst and LinkedIn ghostwriter.\r\n\r\nAnalyze the following tech news and write a LinkedIn post.\r\n\r\nSTRUCTURE:\r\n- Hook (1–2 lines, curiosity-driven)\r\n- Body (clear insight, 3 short paragraphs)\r\n- CTA (invite discussion)\r\n- Hashtags (6–7 relevant)\r\n\r\nTONE:\r\n- Professional\r\n- Founder / strategist voice\r\n- No emojis\r\n- No hype\n\nNEWS:\r\nTitle: {{36.rssFields.title}}\nSummary: {{36.rssFields.description}}"
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 150
                },
                "restore": {
                    "expect": {
                        "model": {
                            "label": "GPT-5.2The most advanced model with superior reasoning, speed, and instruction-following for complex, real-world tasks"
                        }
                    }
                },
                "expect": [
                    {
                        "name": "model",
                        "type": "select",
                        "label": "Model",
                        "required": true,
                        "validate": {
                            "enum": [
                                "gpt-5.2",
                                "gpt-5.1",
                                "gpt-5",
                                "gpt-5-nano",
                                "gpt-5-mini"
                            ]
                        }
                    },
                    {
                        "name": "textPrompt",
                        "type": "text",
                        "label": "Text prompt",
                        "required": true
                    }
                ]
            }
        },
